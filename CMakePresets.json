{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "debug-tests",
            "displayName": "Debug + tests",
            "inherits": "debug",
            "cacheVariables": { "SNAKE_BUILD_TESTS": "ON" }
        },
        {
            "name": "release-tests",
            "displayName": "Release + tests",
            "inherits": "release",
            "cacheVariables": { "SNAKE_BUILD_TESTS": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "debug-tests", "configurePreset": "debug-tests" },
        { "name": "release-tests", "configurePreset": "release-tests" }
    ],
    "testPresets": [
        {
            "name": "debug-tests",
            "configurePreset": "debug-tests",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "ignore" }
        },
        {
            "name": "release-tests",
            "configurePreset": "release-tests",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "ignore" }
        }
    ]
}
